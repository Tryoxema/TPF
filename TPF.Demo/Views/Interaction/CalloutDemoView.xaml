<views:ViewBase x:Class="TPF.Demo.Views.CalloutDemoView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:tpf="http://schemas.tpf.com/xaml/presentation"
                xmlns:views="clr-namespace:TPF.Demo.Views"
                DataContext="{Binding RelativeSource={RelativeSource Self}}"
                mc:Ignorable="d" 
                d:DesignHeight="450" d:DesignWidth="800">
    <views:ViewBase.Settings>
        <StackPanel>
            <StackPanel Margin="0 2">
                <TextBlock Text="Type"/>
                <tpf:ComboBox SelectedValue="{Binding Type}" ItemsSource="{Binding CalloutTypes}"/>
            </StackPanel>
            <StackPanel Margin="0 2">
                <TextBlock Text="ArrowBaseAnchorPoint1"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="X" Margin="5" Grid.Row="0"/>
                    <tpf:Slider Value="{Binding ArrowBaseAnchorPoint1X}" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Grid.Row="0" Grid.Column="1"/>
                    <TextBlock Text="Y" Margin="5" Grid.Row="1"/>
                    <tpf:Slider Value="{Binding ArrowBaseAnchorPoint1Y}" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Grid.Row="1" Grid.Column="1"/>
                </Grid>
            </StackPanel>
            <StackPanel Margin="0 2">
                <TextBlock Text="ArrowBaseAnchorPoint2"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="X" Margin="5" Grid.Row="0"/>
                    <tpf:Slider Value="{Binding ArrowBaseAnchorPoint2X}" Minimum="0" Maximum="1" IsMoveToPointEnabled="True" Grid.Row="0" Grid.Column="1"/>
                    <TextBlock Text="Y" Margin="5" Grid.Row="1"/>
                    <tpf:Slider Value="{Binding ArrowBaseAnchorPoint2Y}" Minimum="-2" Maximum="1" IsMoveToPointEnabled="True" Grid.Row="1" Grid.Column="1"/>
                </Grid>
            </StackPanel>
            <StackPanel Margin="0 2">
                <TextBlock Text="ArrowTargetAnchorPoint"/>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="X" Margin="5" Grid.Row="0"/>
                    <tpf:Slider Value="{Binding ArrowTargetAnchorPointX}" Minimum="-2" Maximum="2" IsMoveToPointEnabled="True" Grid.Row="0" Grid.Column="1"/>
                    <TextBlock Text="Y" Margin="5" Grid.Row="1"/>
                    <tpf:Slider Value="{Binding ArrowTargetAnchorPointY}" Minimum="-2" Maximum="2" IsMoveToPointEnabled="True" Grid.Row="1" Grid.Column="1"/>
                </Grid>
            </StackPanel>

            <tpf:Divider Content="CalloutService"/>
            
            <StackPanel Margin="0 2">
                <TextBlock Text="Placement"/>
                <tpf:ComboBox SelectedValue="{Binding Placement}" ItemsSource="{Binding CalloutPlacements}"/>
            </StackPanel>
            <StackPanel Margin="0 2">
                <TextBlock Text="HorizontalOffset"/>
                <tpf:NumericRangeBox Value="{Binding HorizontalOffset}"/>
            </StackPanel>
            <StackPanel Margin="0 2">
                <TextBlock Text="VerticalOffset"/>
                <tpf:NumericRangeBox Value="{Binding VerticalOffset}"/>
            </StackPanel>
            <CheckBox IsChecked="{Binding StaysOpen}" Content="StaysOpen" Margin="0 2"/>
            <UniformGrid Columns="2">
                <tpf:Button Content="ShowCallout" Click="ShowCalloutButton_Click" Margin="0 0 2 0"/>
                <tpf:Button Content="CloseCallout" Click="CloseCalloutButton_Click" Margin="2 0 0 0"/>
            </UniformGrid>
        </StackPanel>
    </views:ViewBase.Settings>
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <tpf:Callout Content="Wichtige Nachricht" Type="{Binding Type}" ArrowTargetAnchorPoint="{Binding ArrowTargetAnchorPoint}"
                     ArrowBaseAnchorPoint1="{Binding ArrowBaseAnchorPoint1}" ArrowBaseAnchorPoint2="{Binding ArrowBaseAnchorPoint2}"/>

        <tpf:Button x:Name="DemoButton" Content="Klicke hier um reich zu werden" Width="200" Height="40" Grid.Column="1"/>
    </Grid>
</views:ViewBase>