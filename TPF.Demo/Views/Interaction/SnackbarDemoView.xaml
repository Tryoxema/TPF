<views:ViewBase x:Class="TPF.Demo.Views.SnackbarDemoView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                xmlns:tpf="http://schemas.tpf.com/xaml/presentation"
                xmlns:views="clr-namespace:TPF.Demo.Views"
                DataContext="{Binding RelativeSource={RelativeSource Self}}"
                mc:Ignorable="d" 
                d:DesignHeight="450" d:DesignWidth="800">
    <views:ViewBase.Settings>
        <StackPanel>
            <StackPanel Margin="0 2">
                <TextBlock Text="Message"/>
                <TextBox Text="{Binding Message}"/>
            </StackPanel>

            <StackPanel Margin="0 2">
                <TextBlock Text="ActionText"/>
                <TextBox Text="{Binding ActionText}"/>
            </StackPanel>

            <StackPanel Margin="0 2">
                <TextBlock Text="Severity"/>
                <tpf:ComboBox SelectedValue="{Binding Severity}" ItemsSource="{Binding SnackbarSeverities}"/>
            </StackPanel>

            <StackPanel Margin="0 2">
                <TextBlock Text="Duration"/>
                <tpf:NumericRangeBox Value="{Binding Duration}" Minimum="1" Maximum="10" NumberDecimalDigits="0" CustomUnit="s"/>
            </StackPanel>

            <tpf:Button Content="EnqueueMessage" Click="EnqueueMessageButton_Click" Margin="0 2"/>
            <tpf:Button Content="EnqueuePriorityMessage" Click="EnqueuePriorityMessageButton_Click" Margin="0 2"/>
            <tpf:Button Content="Clear" Click="ClearButton_Click" Margin="0 2"/>
        </StackPanel>
    </views:ViewBase.Settings>
    <Grid Margin="5">
        <tpf:Snackbar x:Name="DemoSnackbar"/>
    </Grid>
</views:ViewBase>